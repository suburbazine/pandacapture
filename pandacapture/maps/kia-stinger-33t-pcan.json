     "offset": -14.696, "unit": "psi", "display": "gauge", "min": -15, "max": 30, "warn_above": 25,
     "decimals": 1, "source": "verified",
     "note": "Pre-throttle boost pressure, 0x492 byte 3 x2.11 kPa absolute, shown as psi above 101.3 kPa. No vacuum: it's before the throttle"},
    {"key": "map_kpa", "label": "Manifold pressure", "group": "Engine", "id": "0x557", "byte": 4, "unit": "kPa",
     "display": "gauge", "min": 0, "max": 260, "decimals": 0, "source": "verified",
     "note": "Absolute; 94 engine off, about 33 at idle; tops out at 255"},
    {"key": "throttle", "label": "Throttle", "group": "Engine", "id": "0x329", "byte": 5, "scale": 0.4695,
