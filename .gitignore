# CAN captures and transmit logs can contain the VIN
captures/
*.log

# Firmware build output (firmware/build.py); releases ship it inside the exe
firmware/build/
pandacapture/firmware_bin/*
!pandacapture/firmware_bin/README.txt

# Your own address maps, used by name from maps/ next to the program
/maps/

# Local Arm toolchain (firmware/build.py --toolchain .toolchain/...)
.toolchain/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# PyInstaller
build/
dist/
*.spec

# Whole-flash panda backups (firmware and provisioning of your panda)
backups/

# RP1210/J2534 bridge build output (adapter/build.py)
pandacapture/adapter_bin/
